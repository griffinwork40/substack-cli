#!/usr/bin/env python3
"""substack — Substack CLI (unofficial API wrapper)"""
import sys
import os

# Auto-activate the sibling .venv if we're running under the wrong interpreter
# (e.g. system python lacking typer). This makes the shebang portable.
_script_dir = os.path.dirname(os.path.abspath(__file__))
_venv = os.path.join(_script_dir, ".venv", "bin", "python3")
if not _venv.startswith(sys.prefix) and os.path.isfile(_venv):
    # Also check parent dirs for the venv (repo-root level)
    for _candidate in [_venv, os.path.join(_script_dir, os.pardir, os.pardir, os.pardir, ".venv", "bin", "python3")]:
        _candidate = os.path.normpath(_candidate)
        if os.path.isfile(_candidate) and not sys.prefix.startswith(os.path.dirname(os.path.dirname(_candidate))):
            os.execv(_candidate, [_candidate] + sys.argv)

sys.path.insert(0, _script_dir)

# Import command modules FIRST so their @app.command() / @x_app.command()
# decorators register before main() invokes the Typer app.
from substack_cli import config as _config  # noqa: E402, F401
from substack_cli import read as _read      # noqa: E402, F401
from substack_cli import publish as _publish  # noqa: E402, F401
from substack_cli import manage as _manage    # noqa: E402, F401
from substack_cli import notes as _notes      # noqa: E402, F401
from substack_cli import chat as _chat        # noqa: E402, F401

from substack_cli.app import main  # noqa: E402

if __name__ == "__main__":
    main()